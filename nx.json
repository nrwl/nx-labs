{
  "tasksRunnerOptions": {
    "default": {
      "options": {
        "useLightClient": true
      }
    }
  },
  "workspaceLayout": {
    "appsDir": "e2e",
    "libsDir": "packages"
  },
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build", "build-base"],
      "cache": true
    },
    "publish": {
      "dependsOn": ["build"]
    },
    "build-base": {
      "cache": true
    },
    "test": {
      "cache": true
    },
    "e2e": [
      {
        "parallelism": false
      },
      {
        "filter": {
          "plugin": "@nx/jest/plugin"
        },
        "configurations": {
          "ci": {
            "ci": true,
            "coverage": true
          }
        },
        "options": {
          "runInBand": true
        }
      }
    ],
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^default"]
    }
  },
  "nxCloudId": "6768dc9d08a31c37aecb4fab",
  "nxCloudUrl": "https://staging.nx.app",
  "bust": 2,
  "defaultBase": "main",
  "release": {
    "projects": ["php"],
    "projectsRelationship": "independent",
    "git": {
      "commit": false,
      "tag": true
    },
    "changelog": {
      "projectChangelogs": {
        "file": false,
        "createRelease": "github"
      }
    },
    "version": {
      "preVersionCommand": "bunx nx run-many -t build",
      "currentVersionResolver": "registry",
      "preserveLocalDependencyProtocols": false,
      "manifestRootsToUpdate": ["dist/packages/{projectName}"]
    }
  },
  "analytics": true,
  "plugins": [
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "e2e"
      },
      "include": ["e2e/nx-ignore-e2e/**/*", "e2e/php-e2e/**/*"]
    },
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      },
      "include": ["packages/php/**/*"]
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      },
      "include": [
        "e2e/php-e2e/**/*",
        "packages/nx-ignore/**/*",
        "packages/php/**/*"
      ]
    }
  ]
}
